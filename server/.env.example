# Port to run the server on
PORT=5000

# MongoDB URI (leave blank to automatically boot the In-Memory MongoDB Server!)
MONGODB_URI=

# JWT secret key for signing auth tokens
JWT_SECRET=auracrm_super_secret_master_key_12345

# Google Gemini LLM API Key (optional - built-in CRM mock engine boots if not provided!)
GEMINI_API_KEY=
